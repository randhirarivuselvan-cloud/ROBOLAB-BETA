# Shared OpenAI-compatible provider
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5.6
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# Maximum simultaneous specialist calls.
# 8 is a safe beta default; lower it for stricter provider rate limits.
ROBOLAB_AGENT_CONCURRENCY=8

# Optional final consensus model. Falls back to AI_MODEL.
ROBOLAB_SYNTHESIS_MODEL=

# Optional per-role model overrides.
# If omitted, that specialist uses AI_MODEL.
# Example:
# ROBOLAB_MODEL_ARCHITECT=
# ROBOLAB_MODEL_REQUIREMENTS=
# ROBOLAB_MODEL_SPECIFICATION=
# ROBOLAB_MODEL_FEASIBILITY=
# ROBOLAB_MODEL_BOM=
# ROBOLAB_MODEL_COMPONENT=
# ROBOLAB_MODEL_SENSOR=
# ROBOLAB_MODEL_ACTUATOR=
# ROBOLAB_MODEL_POWER=
# ROBOLAB_MODEL_DIGITAL=
# ROBOLAB_MODEL_ANALOG=
# ROBOLAB_MODEL_EMBEDDED=
# ROBOLAB_MODEL_ARDUINO=
# ROBOLAB_MODEL_ESP32=
# ROBOLAB_MODEL_STM32=
# ROBOLAB_MODEL_RASPBERRY_PI=
# ROBOLAB_MODEL_MICROPYTHON=
# ROBOLAB_MODEL_CPP=
# ROBOLAB_MODEL_PYTHON=
# ROBOLAB_MODEL_FLUTTER=
